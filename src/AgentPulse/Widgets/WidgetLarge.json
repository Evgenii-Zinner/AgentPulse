{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Antigravity Quotas",
      "size": "Medium",
      "weight": "Bolder"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${gemini_circle_image}",
              "size": "Medium"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "Gemini Models",
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "TextBlock",
              "text": "5-Hour: ${gemini_percent}% • Reset in ${gemini_reset}",
              "size": "Small",
              "weight": "Bolder",
              "color": "Accent"
            },
            {
              "type": "TextBlock",
              "text": "Weekly: ${gemini_secondary_percent}% • Reset in ${gemini_secondary_reset}",
              "size": "Small",
              "isSubtle": true
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${claude_circle_image}",
              "size": "Medium"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "Claude and GPT",
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "TextBlock",
              "text": "5-Hour: ${claude_percent}% • ${claude_reset}",
              "size": "Small",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "Weekly: 100%",
              "size": "Small",
              "isSubtle": true
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${argon_circle_image}",
              "size": "Medium"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "Gemini 4 Argon",
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "TextBlock",
              "text": "Weekly: ${argon_percent}% • Reset in ${argon_reset}",
              "size": "Small",
              "weight": "Bolder"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Refresh Quotas",
      "verb": "refresh"
    }
  ]
}
