{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Gemini",
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Center"
            },
            {
              "type": "Image",
              "url": "${gemini_circle_image}",
              "size": "Medium",
              "horizontalAlignment": "Center"
            },
            {
              "type": "TextBlock",
              "text": "${gemini_reset}",
              "size": "Small",
              "horizontalAlignment": "Center",
              "isSubtle": true
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Claude",
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Center"
            },
            {
              "type": "Image",
              "url": "${claude_circle_image}",
              "size": "Medium",
              "horizontalAlignment": "Center"
            },
            {
              "type": "TextBlock",
              "text": "${claude_reset}",
              "size": "Small",
              "horizontalAlignment": "Center",
              "isSubtle": true
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Argon",
              "size": "Small",
              "weight": "Bolder",
              "horizontalAlignment": "Center"
            },
            {
              "type": "Image",
              "url": "${argon_circle_image}",
              "size": "Medium",
              "horizontalAlignment": "Center"
            },
            {
              "type": "TextBlock",
              "text": "${argon_reset}",
              "size": "Small",
              "horizontalAlignment": "Center",
              "isSubtle": true
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "refresh"
    }
  ]
}