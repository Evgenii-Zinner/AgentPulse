<Window
    x:Class="AgentPulse.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AgentPulse"
    xmlns:viewmodels="using:AgentPulse.ViewModels"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="Agent Pulse">

    <Grid Background="#141820">
        <Grid.RowDefinitions>
            <!-- Custom Titlebar (PC Manager style) -->
            <RowDefinition Height="36"/>
            <!-- Body (Rail + Inset Surface) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SYSTEM TRAY ICON (H.NotifyIcon) -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ContextMenuMode="PopupMenu"
            ToolTipText="{x:Bind ViewModel.TrayTooltip, Mode=OneWay}"
            LeftClickCommand="{x:Bind ToggleWindowVisibilityCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Show Agent Pulse" Command="{x:Bind ShowWindowCommand}"/>
                    <MenuFlyoutItem Text="Refresh Quotas" Command="{x:Bind RefreshCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitApplicationCommand}"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- 1. CUSTOM TITLEBAR -->
        <Grid Grid.Row="0" Background="#141820" x:Name="AppTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Icon -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="16" Height="16"/>
                <TextBlock Text="Agent Pulse"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Window Controls (Minimize & Close) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="44" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="OnMinimizeClicked"
                        ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="#A0A0A0"/>
                </Button>
                <Button Width="44" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="OnCloseClicked"
                        ToolTipService.ToolTip="Close to Tray">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" Foreground="#A0A0A0"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. TWO-COLUMN SHELL: LEFT NAV RAIL + MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Nav Rail -->
                <ColumnDefinition Width="60"/>
                <!-- Main Inset Content Surface -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Grid Grid.Column="0" Background="#141820">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Nav Items -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,8,0,0">
                    <!-- Active "AGY" Item with Left Cyan Indicator Pill -->
                    <Grid Height="50" HorizontalAlignment="Stretch">
                        <!-- Left Cyan Selection Indicator Pill (PC Manager style) -->
                        <Border Width="3" Height="20"
                                Background="#4CC2FF"
                                CornerRadius="0,2,2,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="#4CC2FF"/>
                            <TextBlock Text="AGY" FontSize="10" FontWeight="Bold" Foreground="#4CC2FF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Bottom Pin / Always on Top Toggle -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Center" Spacing="4">
                    <Button Width="40" Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Click="OnTogglePinClicked"
                            ToolTipService.ToolTip="Toggle Always on Top">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="14" Foreground="#737A8C"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- MAIN INSET CONTENT SURFACE (PC Manager #1D222B with Top-Left Radius) -->
            <Border Grid.Column="1"
                    Background="#1D222B"
                    CornerRadius="8,0,0,0"
                    Padding="12,12,12,12">
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">

                        <!-- COOLDOWN BANNER (Only visible when throttled) -->
                        <Border Background="#3B1818"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Visibility="{x:Bind GetCooldownVisibility(ViewModel.IsOnCooldown), Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="COOLDOWN" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.CooldownRemainingText, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- HERO CARD: GEMINI DUAL GAUGE (PC Manager Boost Card style) -->
                        <Border Background="#252A34" CornerRadius="6" Padding="14,14">
                            <StackPanel Spacing="12">
                                <!-- Clean Title with small refresh button at the end -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Gemini" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="26" Height="26"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            Click="OnRefreshClicked"
                                            ToolTipService.ToolTip="Refresh Limits">
                                        <Grid>
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#4CC2FF"
                                                      Visibility="{x:Bind GetInvertedVisibility(ViewModel.IsLoading), Mode=OneWay}"/>
                                            <ProgressRing Width="12" Height="12"
                                                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                                          Visibility="{x:Bind GetLoadingVisibility(ViewModel.IsLoading), Mode=OneWay}"
                                                          Foreground="#4CC2FF"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <!-- Concentric Dual Rings Gauge -->
                                <Grid Width="110" Height="110" HorizontalAlignment="Center">
                                    <!-- Outer 5h Ring -->
                                    <Ellipse Width="110" Height="110" Stroke="#181C24" StrokeThickness="7"/>
                                    <ProgressRing Width="110" Height="110"
                                                  IsIndeterminate="False"
                                                  Value="{x:Bind ViewModel.AntigravityGemini.Percent, Mode=OneWay}"
                                                  Foreground="#FFFFFF"/>

                                    <!-- Inner Weekly Ring -->
                                    <Ellipse Width="76" Height="76" Stroke="#13171F" StrokeThickness="5"/>
                                    <ProgressRing Width="76" Height="76"
                                                  IsIndeterminate="False"
                                                  Value="{x:Bind ViewModel.AntigravityGemini.SecondaryPercent, Mode=OneWay}"
                                                  Foreground="#4CC2FF"/>

                                    <!-- Numbers in Center (No redundant words) -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{x:Bind ViewModel.AntigravityGemini.FormattedPercent, Mode=OneWay}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.AntigravityGemini.FormattedSecondaryPercent, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4CC2FF"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Distinct Reset Timers (No duplicate labels or words) -->
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="5-Hour" FontSize="10" FontWeight="SemiBold" Foreground="#888E9E" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.AntigravityGemini.ResetText, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Weekly" FontSize="10" FontWeight="SemiBold" Foreground="#4CC2FF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.AntigravityGemini.SecondaryResetText, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#4CC2FF"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SUB-GAUGES GRID: 2 COLUMNS (CLAUDE & ARGON) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            
                            <!-- 1. Claude & GPT Card -->
                            <Border Grid.Column="0" Background="#252A34" CornerRadius="6" Padding="12,14">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="Claude &amp; GPT" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>

                                    <Grid Width="74" Height="74" HorizontalAlignment="Center">
                                        <Ellipse Width="74" Height="74" Stroke="#181C24" StrokeThickness="5"/>
                                        <ProgressRing Width="74" Height="74"
                                                      IsIndeterminate="False"
                                                      Value="{x:Bind ViewModel.AntigravityClaude.Percent, Mode=OneWay}"
                                                      Foreground="#FFFFFF"/>

                                        <Ellipse Width="50" Height="50" Stroke="#13171F" StrokeThickness="4"/>
                                        <ProgressRing Width="50" Height="50"
                                                      IsIndeterminate="False"
                                                      Value="{x:Bind ViewModel.AntigravityClaude.SecondaryPercent, Mode=OneWay}"
                                                      Foreground="#4CC2FF"/>

                                        <TextBlock Text="{x:Bind ViewModel.AntigravityClaude.FormattedPercent, Mode=OneWay}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{x:Bind ViewModel.AntigravityClaude.ResetText, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="#888E9E"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Gemini 4 Argon Card -->
                            <Border Grid.Column="1" Background="#252A34" CornerRadius="6" Padding="12,14">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="Gemini 4 Argon" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>

                                    <Grid Width="74" Height="74" HorizontalAlignment="Center">
                                        <Ellipse Width="74" Height="74" Stroke="#181C24" StrokeThickness="5"/>
                                        <ProgressRing Width="74" Height="74"
                                                      IsIndeterminate="False"
                                                      Value="{x:Bind ViewModel.AntigravityArgon.Percent, Mode=OneWay}"
                                                      Foreground="#FFFFFF"/>

                                        <TextBlock Text="{x:Bind ViewModel.AntigravityArgon.FormattedPercent, Mode=OneWay}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{x:Bind ViewModel.AntigravityArgon.ResetText, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="#888E9E"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
