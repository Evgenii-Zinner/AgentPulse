<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AgentPulse.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentPulse"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Black & White Minimalist Tokens -->
            <SolidColorBrush x:Key="MonoBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="MonoSurfaceBrush" Color="#0C0C0C" />
            <SolidColorBrush x:Key="MonoBorderBrush" Color="#222222" />
            <SolidColorBrush x:Key="MonoTrackBrush" Color="#222222" />
            <SolidColorBrush x:Key="MonoTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MonoTextSecondaryBrush" Color="#A3A3A3" />
            <SolidColorBrush x:Key="MonoTextMutedBrush" Color="#525252" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
